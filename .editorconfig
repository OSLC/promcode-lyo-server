root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[promcode-lyo-server/src/test/java/**.java]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{xml,aird}]
trim_trailing_whitespace = false

[promcode-lyo-server-model/**]
indent_size = 2
